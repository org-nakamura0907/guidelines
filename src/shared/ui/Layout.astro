---
import { withBasePath } from "@/shared";
import SidebarLoader from "./SidebarLoader.astro";
import "../../styles/global.css";

interface Props {
	title?: string;
}

const { title } = Astro.props;
const pageTitle = title
	? `${title} | nakamura0907のガイドライン`
	: "nakamura0907のガイドライン";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBasePath("/favicon.svg")} />
		<link rel="icon" href={withBasePath("/favicon.ico")} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-screen">
		<SidebarLoader />
		<main class="px-8 py-6 pt-20 md:pl-72 md:pt-6">
			<slot />
		</main>
	</body>
</html>
